# Copia este archivo como .env y llena los valores desde
# Firebase Console → Configuración del proyecto → Tus apps → App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend (opcional). Déjalo comentado: la app llama a /api en su mismo dominio y lo reenvían
# el proxy de Vite (desarrollo) o vercel.json / public/_redirects (producción), evitando CORS.
# Úsalo solo para apuntar directo a un backend cuyo CORS permita tu dominio.
# VITE_API_BASE_URL=https://lapticon-backend.onrender.com
